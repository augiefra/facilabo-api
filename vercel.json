{
  "functions": {
    "api/v1/local-events/internal/ingest.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/local-events/internal/ingest",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/api/v1/calendars/metadata/:slug",
      "destination": "https://core.facilabo.com/api/v1/calendars/metadata/:slug",
      "permanent": false
    },
    {
      "source": "/api/v1/calendars/:slug((?!list$)[^/]+)",
      "destination": "https://core.facilabo.com/api/v1/calendars/:slug",
      "permanent": false
    },
    {
      "source": "/api/calendar/rugby/:team",
      "destination": "https://core.facilabo.com/api/calendar/rugby/:team",
      "permanent": false
    },
    {
      "source": "/api/calendar/jardin/lunaire",
      "destination": "https://core.facilabo.com/api/calendar/jardin/lunaire",
      "permanent": false
    },
    {
      "source": "/api/v1/local-events/ics/:target",
      "destination": "https://core.facilabo.com/api/v1/local-events/ics/:target",
      "permanent": false
    },
    {
      "source": "/api/v1/sports/results/:sport([Ff][Oo][Oo][Tt][Bb][Aa][Ll][Ll]|[Rr][Uu][Gg][Bb][Yy])",
      "destination": "https://core.facilabo.com/api/v1/sports/results/:sport",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "s-maxage=3600, stale-while-revalidate" }
      ]
    },
    {
      "source": "/api/v1/health/status",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/v1/calendars/:slug",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
